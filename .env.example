# ==========================================
# Kasa AutoBox Cloud - Environment Config
# ==========================================

# Mode: 'mock' (default zero-config local simulation) or 'aws' (live AWS resources)
NEXT_PUBLIC_APP_MODE=mock

# AWS Region (Used when NEXT_PUBLIC_APP_MODE=aws)
AWS_REGION=us-east-1

# Optional AWS Credentials (If running with IAM user instead of default AWS CLI profile/roles)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS ECS Cluster and Task Configuration
AWS_ECS_CLUSTER=kasa-autobox-cluster
AWS_ECS_SUBNETS=subnet-12345678,subnet-87654321
AWS_ECS_SECURITY_GROUPS=sg-12345678

# Amazon DynamoDB Table
AWS_DYNAMODB_TABLE=kasa-autobox-sandboxes

# Amazon CloudWatch Log Group
AWS_CLOUDWATCH_LOG_GROUP=/ecs/kasa-autobox-sandboxes
